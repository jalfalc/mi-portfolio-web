---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: "Enero 2026 - Julio 2026",
    title: "Desarrollo de aplicaciones Web | Técnico de Soporte IT",
    company: "Almagro Capital S.L.",
    descriptions: [
      "Relación laboral basada principalmente en el mantenimiento y desarrollo de sitios web basados en WordPress, así como en la creación de flujos y automatizaciones en Zoho CRM.",
      "También realicé labores de soporte técnico a los usuarios de la empresa, desde la preparación y puesta a punto de equipos informáticos hasta la resolución de incidencias de hardware y software."
    ],
    tasks: [
      "Desarrollo, mantenimiento e implementación de nuevas funcionalidades en sitios web basados en WordPress, utilizando tecnologías como PHP, JavaScript, Elementor Pro y Divi.",
      "Integración de sitios web con Zoho CRM mediante APIs para la automatización y sincronización de datos.",
      "Desarrollo e implementación de nuevas funcionalidades y flujos de trabajo en Zoho CRM, adaptados a las necesidades del negocio.",
      "Automatización de procesos mediante Microsoft Power Automate, integrando servicios de Microsoft 365 para optimizar flujos de trabajo, incluyendo la gestión de archivos adjuntos de correo en SharePoint, la extracción y transformación de datos de distintos sistemas de la empresa y su preparación para análisis posteriores.",
      "Limpieza, transformación y preparación de datos en Microsoft Excel para importaciones masivas y mantenimiento de la calidad de la información en el CRM.",
      "Soporte técnico a usuarios, resolución de incidencias y configuración de equipos, impresoras, perfiles y migraciones de entornos de trabajo.",
    ],
    technologies: [
      "PHP",
      "Javascript",
      "Wordpress",
      "Zoho CRM",
      "Power Automate",
      "Sharepoint",
      "Excel",
      "Elementor",
      "Divi"
    ],
  },
  {
    date: "Abril 2025 - Junio 2025",
    title: "Desarrollador web frontend -  Contrato de prácticas",
    company: "Avocoding S.L.",
    descriptions: [
      "Participación en la creación del sitio web de la empresa basado en una SPA desarrollada con React y Typescript."
    ],
    tasks: [
      "Participación en el desarrollo de un proyecto web con React, aplicando principios de diseño modular y reutilización de componentes.",
      "Configuración e integración de herramientas de control de estilo y calidad de código: ESLint, Stylelint, Prettier y Husky.",
      "Implementación de efectos visuales y animaciones utilizando GSAP y ReactBits.",
      "Desarrollo de interfaces con HeroUI, empleando su sistema de componentes.",
      "Creación de componentes personalizados, custom hooks y uso de React Context para la gestión de estado y lógica compartida.",
      "Trabajo en equipo bajo metodología Scrum, con sprints de 14 días y reuniones de seguimiento.",
      "Revisión y evaluación de pull requests de compañeros, comprobando el uso de buenas prácticas y un correcto funcionamiento.",
    ],
    technologies: [
      "React",
      "Typescript",
      "Sass",
      "Gsap",
      "HeroUI",
      "ESLint",
      "Prettier",
      "Husky",
      "Git",
    ],
  },
];
---

<ol class="relative mt-50 space-y-8">
  {
    EXPERIENCE.map((experience) => (
      <li>
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
